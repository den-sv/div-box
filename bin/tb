#!/bin/sh
# Divoom Timebox Mini CLI — stdlib Python only, nothing installed. Works through symlinks (e.g. /opt/homebrew/bin/tb).
exec /usr/bin/env python3 -I -c "import os, sys; sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(sys.argv.pop(1))))); from timebox.cli import main; main()" "$0" "$@"
